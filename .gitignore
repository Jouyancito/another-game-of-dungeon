# Godot
.godot/
*.import
export_presets.cfg

# Godot engine binary
Godot_v*.exe/
Godot_v*.exe

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
*.swp
*.swo

# Dept status (runtime state, sync via engram no via git)
.dept-status/*.json
!.dept-status/README.md

# Claude Code coordination state (local per-worker)
.claude/
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**

# Test artifacts
.test-hook
INFORME_PERSONAL.md

# Secrets — never commit env files (preventive)
.env
.env.*
!.env.example
!.env.*.example

# Raw asset packs (CC0 zips/source) — keep originals local, commit only extracted assets
game/assets/art/_raw/

# Engram local state
.engram/

# Dev scratch renders (throwaway preview/diagnostic PNGs — regenerable)
game/tools/godot/_golem_*.png
game/tools/godot/_t_*.png
game/tools/blender/_pg_*.png
game/tools/blender/_preview_golem.png

.atl/

# Golem animation frame dumps — regenerable output of the capture scenes.
# Kept on disk, out of history: 650+ PNGs (~14MB) per pipeline run.
game/tools/godot/anim_capture/
*.blend1
game/tools/blender/*/renders/anim/
