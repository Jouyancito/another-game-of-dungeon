# Godot
.godot/
*.import
export_presets.cfg

# Godot engine binary
Godot_v*.exe/
Godot_v*.exe

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
*.swp
*.swo

# Dept status (runtime state, sync via engram no via git)
.dept-status/*.json
!.dept-status/README.md

# Claude Code coordination state (local per-worker)
.claude/
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**

# Test artifacts
.test-hook
INFORME_PERSONAL.md

# Secrets — never commit env files (preventive)
.env
.env.*
!.env.example
!.env.*.example

# Raw asset packs (CC0 zips/source) — keep originals local, commit only extracted assets
game/assets/art/_raw/

# Engram local state
.engram/

# Dev scratch renders (throwaway preview/diagnostic PNGs — regenerable)
game/tools/godot/_golem_*.png
game/tools/godot/_t_*.png
game/tools/blender/_pg_*.png
game/tools/blender/_preview_golem.png

.atl/

# Golem animation frame dumps — regenerable output of the capture scenes.
# Kept on disk, out of history: 650+ PNGs (~14MB) per pipeline run.
game/tools/godot/anim_capture/
*.blend1
game/tools/blender/*/renders/anim/
game/tools/blender/**/*_run.log
game/tools/blender/**/__pycache__/
__pycache__/

# GLB truth renders (regenerable diagnostic output of _glb_truth_render.py)
game/tools/blender/_truth/
# Same output, per-pack location (tree_pack v2 writes renders/_truth/): ~27 MB
# of 1.6 MB PNGs per run, regenerable from the .glb by truth_showcase.py.
game/tools/blender/*/renders/_truth/

# Per-pack resized texture cache (_cache_resized() output). Derived from the
# motor's _textures/ library, regenerated on any build, one copy per pack.
game/tools/blender/*/_tex/

# Salida del probe de shimmer (cientos de PNG por corrida, regenerables).
# analyze.py y el .gdignore SI se versionan.
game/tools/godot/shimmer_probe/*/
