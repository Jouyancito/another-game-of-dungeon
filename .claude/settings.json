            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/dept-bus-check.ps1\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/dept-bus-check.ps1\""
          }
