[gd_scene format=3 uid="uid://mimicchest01"]

[ext_resource type="Script" path="res://scenes/enemy/mimic.gd" id="1_mimic"]

; ========================================================================
; MimicChest — escena art + script gameplay wireado (post-merge integration).
; B agrega script gameplay (mimic.gd) + signals (`disguise_revealed`,
; `mimic_died`, `reveal_animation_finished`) extendiendo BaseEnemy o similar.
;
; Visual disguised: idéntico a loot_chest.tscn (BoxMesh body 1.0×0.6×0.7,
; lid 1.0×0.15×0.7, color #73502666 madera). Sub-meshes revealed
; (Teeth/Eyes/Tongue) están `visible = false` por default — la animación
; "reveal" los activa.
;
; AnimationPlayer expone:
;   - "RESET"   → estado disguised (default, autoplay)
;   - "reveal"  → 0.6s anim que abre la tapa, muestra dientes/ojos/lengua
; B escucha `AnimationPlayer.animation_finished` con anim_name == "reveal"
; para emitir su signal `reveal_animation_finished` y transicionar a
; AGGRESSIVE.
; ========================================================================

; ---------- Materiales ----------

[sub_resource type="StandardMaterial3D" id="Material_wood"]
albedo_color = Color(0.45, 0.3, 0.15, 1)
roughness = 0.85

[sub_resource type="StandardMaterial3D" id="Material_tooth"]
albedo_color = Color(0.96, 0.96, 0.92, 1)
roughness = 0.4

[sub_resource type="StandardMaterial3D" id="Material_eye"]
albedo_color = Color(1.0, 0.84, 0.0, 1)
emission_enabled = true
emission = Color(1.0, 0.84, 0.0, 1)
emission_energy_multiplier = 2.5
roughness = 0.2

[sub_resource type="StandardMaterial3D" id="Material_tongue"]
albedo_color = Color(0.85, 0.35, 0.45, 1)
roughness = 0.6

[sub_resource type="StandardMaterial3D" id="Material_mouth_inner"]
albedo_color = Color(0.15, 0.05, 0.05, 1)
roughness = 1.0

; ---------- Geometría ----------

[sub_resource type="BoxShape3D" id="Shape_body"]
size = Vector3(1.0, 0.6, 0.7)

[sub_resource type="BoxMesh" id="Mesh_body"]
size = Vector3(1.0, 0.6, 0.7)
material = SubResource("Material_wood")

[sub_resource type="BoxMesh" id="Mesh_lid"]
size = Vector3(1.0, 0.15, 0.7)
material = SubResource("Material_wood")

[sub_resource type="BoxMesh" id="Mesh_mouth_inner"]
; Plano interior visible cuando la tapa abre — evita ver hueco vacío
size = Vector3(0.95, 0.02, 0.65)
material = SubResource("Material_mouth_inner")

[sub_resource type="PrismMesh" id="Mesh_tooth"]
; Diente: prisma triangular pequeño, altura 0.18
size = Vector3(0.1, 0.18, 0.08)
material = SubResource("Material_tooth")

[sub_resource type="SphereMesh" id="Mesh_eye"]
radius = 0.07
height = 0.14
material = SubResource("Material_eye")

[sub_resource type="BoxMesh" id="Mesh_tongue"]
size = Vector3(0.35, 0.04, 0.32)
material = SubResource("Material_tongue")

