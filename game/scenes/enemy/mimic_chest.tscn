; ========================================================================
; SCENE TREE
; ========================================================================

[node name="MimicChest" type="CharacterBody3D" groups=["enemies", "interactables"]]
collision_layer = 4
collision_mask = 3
script = ExtResource("1_mimic")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 0)
shape = SubResource("Shape_body")

; Cuerpo del cofre — idéntico a loot_chest.tscn (mesh + transform + material)
[node name="ChestBody" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 0)
mesh = SubResource("Mesh_body")

; Plano oscuro interior — sólo visible cuando la tapa abre, evita ver hueco
[node name="MouthInner" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.602, 0)
mesh = SubResource("Mesh_mouth_inner")
visible = false

; Pivot de la tapa: ubicado en el borde TRASERO-SUPERIOR del cuerpo (z = -0.35, y = 0.6).
; Rotar este nodo en X abre la tapa hacia atrás. La LidMesh está offset
; hacia adelante para que su geometría reproduzca la posición original
; del lid de loot_chest (centro mesh: y=0.675, z=-0.275).
[node name="LidPivot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, -0.35)

[node name="LidMesh" type="MeshInstance3D" parent="LidPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.075, 0.075)
mesh = SubResource("Mesh_lid")

; Dientes superiores (cuelgan del lid, rotan con él)
[node name="TeethUpper" type="Node3D" parent="LidPivot"]
visible = false

[node name="ToothU1" type="MeshInstance3D" parent="LidPivot/TeethUpper"]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, -0.30, 0.0, 0.30)
mesh = SubResource("Mesh_tooth")

[node name="ToothU2" type="MeshInstance3D" parent="LidPivot/TeethUpper"]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0.0, 0.0, 0.30)
mesh = SubResource("Mesh_tooth")

[node name="ToothU3" type="MeshInstance3D" parent="LidPivot/TeethUpper"]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0.30, 0.0, 0.30)
mesh = SubResource("Mesh_tooth")

; Dientes inferiores (sobre el borde superior del cuerpo)
[node name="TeethLower" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.7, 0)
visible = false

[node name="ToothL1" type="MeshInstance3D" parent="TeethLower"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.30, 0.0, 0.30)
mesh = SubResource("Mesh_tooth")

[node name="ToothL2" type="MeshInstance3D" parent="TeethLower"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.0, 0.0, 0.30)
mesh = SubResource("Mesh_tooth")

[node name="ToothL3" type="MeshInstance3D" parent="TeethLower"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.30, 0.0, 0.30)
mesh = SubResource("Mesh_tooth")

; Lengua — sale del centro de la boca
[node name="Tongue" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.625, 0.05)
mesh = SubResource("Mesh_tongue")
visible = false

; Ojos — sobre la cara frontal del cuerpo (z = +0.35)
[node name="EyeLeft" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.22, 0.45, 0.36)
mesh = SubResource("Mesh_eye")
visible = false

[node name="EyeRight" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.22, 0.45, 0.36)
mesh = SubResource("Mesh_eye")
visible = false

; AnimationPlayer
[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
libraries = {
"": SubResource("AnimLibrary")
}
autoplay = "RESET"

; Label "Cofre [E]" — idéntico a loot_chest hasta el reveal.
; B oculta este label (`visible = false`) cuando dispara `reveal_animation_finished`.
[node name="Label3D" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 0)
billboard = 1
font_size = 28
outline_size = 6
text = "Cofre [E]"
visible = false
